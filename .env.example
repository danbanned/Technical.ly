VITE_CESIUM_ION_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
CLIENT_ID=
CLIENT_SECRETE=

# AI narration + AI Solutions (off by default). Set to true only if ANTHROPIC_API_KEY
