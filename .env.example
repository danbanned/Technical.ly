# Cesium ion token. Needed for OSM 3D Buildings (ion asset 96188).
VITE_CESIUM_ION_TOKEN=

# Optional: enables the Google Photorealistic 3D Tiles toggle.
VITE_GOOGLE_MAPS_API_KEY=

# AI narration + AI Solutions (off by default). Set to true only if ANTHROPIC_API_KEY
# is set on Vercel. ANTHROPIC_API_KEY is server-only — never prefix it with VITE_.
VITE_ENABLE_NARRATION=

# Optional: free CARTO basemap key (carto.com/basemaps/apikey). Unset = Esri basemap, no key needed.
VITE_CARTO_API_KEY=
